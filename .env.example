# GEMINI_API_KEY: Required for Gemini AI API calls if AI tools are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Supabase Independent Blog CMS Configuration (Server-Side Only)
# Never expose SUPABASE_SERVICE_ROLE_KEY in client-side / VITE_* variables.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="blog-media"

# Optional comma-separated allowlist of verified Supabase Auth admin emails
SUPABASE_ADMIN_EMAILS="admin@insightmarketing.co.ke"
